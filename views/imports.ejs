<header class="page-head">
  <div>
    <p class="eyebrow">Bank Data</p>
    <h1>Import History</h1>
    <p class="lede">Every batch from a scheduled import, a manual upload, or the live feed. Times are India Standard Time.</p>
  </div>
</header>
<div class="table-wrap">
  <table class="stack-rows">
    <thead>
      <tr><th>Batch</th><th>Source</th><th>Received (IST)</th><th class="num">Accepted</th><th class="num">Rejected</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% if (!rows.length) { %><tr><td colspan="6" class="empty">No imports yet.</td></tr><% } %>
      <% rows.forEach((row) => { %>
        <tr>
          <td data-label="Batch"><a href="/imports/<%= row.batch_id %>"><%= batchName(row) %></a></td>
          <td data-label="Source"><%= sourceLabel(row.source) %></td>
          <td data-label="Received (IST)"><%= prettyDateTime(row.uploaded_at) %></td>
          <td class="num" data-label="Accepted"><%= row.loaded_count %></td>
          <td class="num" data-label="Rejected"><%= row.error_count %></td>
          <td data-label="Status"><span class="pill <%= String(row.status).replace(/_/g, '-') %>"><%= label(row.status) %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% if (pages > 1) { %>
  <nav class="pager" aria-label="Import pages">
    <% if (page > 1) { %><a href="<%= pageHref('/imports', {}, page - 1) %>">Previous</a><% } %>
    <span>Page <%= page %> of <%= pages %></span>
    <% if (page < pages) { %><a href="<%= pageHref('/imports', {}, page + 1) %>">Next</a><% } %>
  </nav>
<% } %>
