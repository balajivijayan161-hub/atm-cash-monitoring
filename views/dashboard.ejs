<header class="page-head">
  <div>
    <p class="eyebrow">Month to date</p>
    <h1>Fleet Uptime</h1>
    <p class="lede">Availability, cash-out pressure, and how weekend withdrawals sit against the cash still in the machines.</p>
  </div>
  <form method="post" action="<%= simulator.running ? '/live-feed/stop' : '/live-feed/start' %>">
    <button class="btn <%= simulator.running ? 'btn-danger' : 'btn-primary' %>" type="submit"><%= simulator.running ? 'Stop Live Feed' : 'Live Feed' %></button>
    <% if (simulator.running) { %><p class="hint">The live feed is on and stops itself after 15 minutes.</p><% } %>
  </form>
</header>

<section class="section">
  <h2>Cash Alerts</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>ATM</th><th class="num">Cash</th><th class="num">Capacity</th><th>Opened</th></tr></thead>
      <tbody>
        <% if (!alerts.length) { %><tr><td colspan="4" class="empty">No open replenishment alerts.</td></tr><% } %>
        <% alerts.forEach((row) => { %>
          <tr>
            <td><a href="/atms/<%= row.atm_id %>"><%= row.atm_code %></a><br><span class="hint"><%= row.site_name %></span></td>
            <td class="num"><%= inr(row.current_cash) %></td>
            <td class="num"><%= inr(row.capacity_amount) %></td>
            <td><%= prettyDateTime(row.created_at) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (alertTotal > alerts.length) { %>
    <p class="hint" style="margin-top:8px"><a href="/alerts">+<%= alertTotal - alerts.length %> more</a></p>
  <% } %>
  <% if (downtimeOpen.length) { %>
    <p class="hint" style="margin-top:8px">Open downtime: <% downtimeOpen.forEach((row, index) => { %><% if (index) { %>, <% } %><a href="/atms/<%= row.atm_id %>"><%= row.atm_code %></a> <%= label(row.reason) %><% }) %><% if (downtimeTotal > downtimeOpen.length) { %> · <a href="/downtime">+<%= downtimeTotal - downtimeOpen.length %> more</a><% } %>.</p>
  <% } else if (downtimeTotal > 0) { %>
    <p class="hint" style="margin-top:8px"><a href="/downtime">+<%= downtimeTotal %> more open downtime</a></p>
  <% } %>
</section>

<section class="kpi-grid" aria-label="Fleet indicators">
  <article class="kpi">
    <span>Fleet Uptime</span>
    <strong><%= uptime == null ? '—' : pct(uptime) %></strong>
    <em><%= fleet.atms || 0 %> ATMs in the elapsed month</em>
  </article>
  <article class="kpi">
    <span>Above 5% Downtime</span>
    <strong><%= fleet.above_five || 0 %></strong>
    <em><a href="/reports/downtime-atms">Open the exception list</a></em>
  </article>
  <article class="kpi">
    <span>Open Fault Tickets</span>
    <strong><%= tickets.open_tickets || 0 %></strong>
    <em><%= tickets.open_variances || 0 %> from cash variances</em>
  </article>
  <article class="kpi">
    <span>Cash-Out or Down</span>
    <strong><%= (fleet.cash_out || 0) + (fleet.out_of_service || 0) %></strong>
    <em><%= fleet.cash_out || 0 %> empty · <%= fleet.out_of_service || 0 %> out of service</em>
  </article>
  <article class="kpi">
    <span>Dispensed Yesterday</span>
    <strong><%= inr(dispensed.amount) %></strong>
    <em><%= dispensed.txns || 0 %> bank transactions</em>
  </article>
  <article class="kpi">
    <span>Runs Today</span>
    <strong><%= runs.today_runs || 0 %></strong>
    <em><%= runs.tomorrow_planned || 0 %> already planned for tomorrow</em>
  </article>
</section>

<section class="chart-grid">
  <article class="card">
    <h3>Uptime by Location</h3>
    <div class="chart-box"><canvas id="uptime-chart"></canvas></div>
  </article>
  <article class="card">
    <h3>Downtime Minutes, Last 14 Days</h3>
    <div class="chart-box"><canvas id="day-chart"></canvas></div>
  </article>
</section>

<section class="section card">
  <h3>Withdrawals by Weekday, Last 8 Weeks</h3>
  <p class="hint">Friday and Saturday should stand above the midweek columns. That spike is what empties cassettes before Monday.</p>
  <div class="chart-box compact"><canvas id="weekday-chart"></canvas></div>
</section>

<section class="section two-col">
  <div>
    <h2>Lowest Availability</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>ATM</th><th>Location</th><th>Status</th><th class="num">Downtime</th></tr>
        </thead>
        <tbody>
          <% if (!worst.length) { %>
            <tr><td colspan="4" class="empty">No ATMs yet.</td></tr>
          <% } %>
          <% worst.forEach((row) => { %>
            <tr>
              <td><a href="/atms/<%= row.atm_id %>"><%= row.atm_code %></a><br><span class="hint"><%= row.site_name %></span></td>
              <td><%= row.location_name %></td>
              <td><span class="pill <%= String(row.status).replace(/_/g, '-') %>"><%= label(row.status) %></span></td>
              <td class="num"><%= pct(row.downtime_pct) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <div>
    <h2>Latest Tickets</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Ticket</th><th>ATM</th><th>Status</th></tr></thead>
        <tbody>
          <% if (!recentTickets.length) { %>
            <tr><td colspan="3" class="empty">No fault tickets yet.</td></tr>
          <% } %>
          <% recentTickets.forEach((row) => { %>
            <tr>
              <td><a href="/tickets?ticket=<%= row.ticket_id %>#ticket-<%= row.ticket_id %>"><%= row.ticket_no %></a><br><span class="hint"><%= row.title %></span></td>
              <td><%= row.atm_code %></td>
              <td><span class="pill <%= row.status %>"><%= label(row.status) %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section">
  <h2>Where the Work Is</h2>
  <div class="link-grid">
    <a href="/forecast"><strong>Cash Forecast</strong><span>Expected cash need for one ATM, from the same weekday over the last four weeks.</span></a>
    <a href="/runs"><strong>Replenishment Runs</strong><span>Groups ATMs whose forecast exceeds remaining cash onto vans and custodians.</span></a>
    <a href="/runs/new"><strong>Cassette Loads</strong><span>A run with one row per cassette. Total loaded updates as note counts change.</span></a>
    <a href="/reconciliations/new"><strong>Reconciliation</strong><span>When the counted cash does not match the expected total, a fault ticket is opened.</span></a>
    <a href="/reports/downtime-atms"><strong>Downtime Above 5%</strong><span>ATMs whose month-to-date outage exceeds 5% of elapsed minutes.</span></a>
    <a href="/reports/van-cashouts"><strong>Van Cash-Outs</strong><span>Each cash-out ticket counted once, against the van that last serviced the ATM on or before that day.</span></a>
    <a href="/reports/withdrawal-matrix"><strong>Withdrawal Matrix</strong><span>Withdrawal totals for the last eight weeks, one location at a time.</span></a>
    <a href="/reports/downtime-by-location"><strong>Downtime by Location</strong><span>Outage minutes and uptime rolled up to each city.</span></a>
    <a href="/switch"><strong>Bank Data Import</strong><span>Load a daily bank file and save the valid withdrawal totals.</span></a>
  </div>
</section>

<script src="/vendor/chart.umd.js"></script>
<script>
  const charts = <%- jsonScript(charts) %>;
  if (typeof Chart !== 'undefined') {
    Chart.defaults.font.family = 'Outfit, sans-serif';
    Chart.defaults.color = '#5e574c';
    const brass = '#8d6a3a';
    const ink = '#1b2421';
    const clay = '#8d2f2f';
    const sized = { responsive: true, maintainAspectRatio: false };
    new Chart(document.getElementById('uptime-chart'), {
      type: 'bar',
      data: { labels: charts.locations, datasets: [{ label: 'Uptime %', data: charts.uptime, backgroundColor: ink, borderRadius: 4 }] },
      options: { ...sized, plugins: { legend: { display: false } }, scales: { y: { min: 80, max: 100 } } }
    });
    new Chart(document.getElementById('day-chart'), {
      type: 'line',
      data: { labels: charts.days, datasets: [{ label: 'Minutes', data: charts.downtimeMinutes, borderColor: clay, backgroundColor: 'rgba(141,47,47,0.12)', fill: true, tension: 0.25 }] },
      options: { ...sized, plugins: { legend: { display: false } } }
    });
    new Chart(document.getElementById('weekday-chart'), {
      type: 'bar',
      data: { labels: charts.weekdays, datasets: [{ label: 'Dispensed', data: charts.weekdayAmounts, backgroundColor: charts.weekdays.map((day) => (day === 'Fri' || day === 'Sat' || day === 'Sun') ? brass : '#cfc3ae'), borderRadius: 4 }] },
      options: { ...sized, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        ['uptime-chart', 'day-chart', 'weekday-chart'].forEach((id) => {
          const chart = Chart.getChart(id);
          if (chart) chart.resize();
        });
      });
    }
  }
  (function () {
    let seen = null;
    setInterval(async () => {
      try {
        const body = await fetch('/live-feed/status').then((res) => res.json());
        if (seen && seen.running && (!body.running || body.ticks !== seen.ticks)) {
          location.reload();
          return;
        }
        seen = body;
      } catch (err) { /* leave the page as it is */ }
    }, 5000);
  }());
</script>
