<header class="page-head">
  <div>
    <p class="eyebrow">Variance case</p>
    <h1><%= item.atm_code %></h1>
    <p class="lede"><%= label(item.case_status) %>. Difference <%= inr(item.difference) %> on <%= prettyDate(item.recon_date) %>.</p>
  </div>
  <a class="btn" href="/reports/recon-ageing">Open Case Ageing</a>
</header>
<section class="section">
  <h2>Notes</h2>
  <% if (!comments.length) { %><p class="empty">No notes yet.</p><% } %>
  <% comments.forEach((note) => { %>
    <p class="hint"><strong><%= note.full_name || 'Operator' %></strong> · <%= exactDateTime(note.created_at) %><br><%= note.body %></p>
  <% }) %>
  <form method="post" action="/reconciliations/<%= item.reconciliation_id %>/comment" class="filters">
    <%- csrfField %>
    <label class="field grow">Add a note<textarea name="body" required maxlength="2000"></textarea></label>
    <button class="btn" type="submit">Add Note</button>
  </form>
</section>
<% if (item.case_status === 'raised' || item.case_status === 'investigating') { %>
  <form method="post" action="/reconciliations/<%= item.reconciliation_id %>/status" class="card" style="padding:14px">
    <%- csrfField %>
    <div class="form-grid">
      <label class="field">Next status
        <select name="case_status">
          <% if (item.case_status === 'raised') { %><option value="investigating">Investigating</option><% } %>
          <% if (item.case_status === 'investigating' && canApprove) { %>
            <option value="resolved">Resolved</option>
            <option value="written_off">Written Off</option>
          <% } %>
        </select>
      </label>
      <label class="field">Reason
        <select name="reason_code">
          <option value="">Choose</option>
          <% reasons.forEach((reason) => { %>
            <option value="<%= reason %>" <%= item.reason_code === reason ? 'selected' : '' %>><%= label(reason) %></option>
          <% }) %>
        </select>
      </label>
      <label class="field">Assignee
        <select name="assignee_id">
          <option value="">Unchanged</option>
          <% people.forEach((person) => { %>
            <option value="<%= person.user_id %>" <%= String(item.assignee_id) === String(person.user_id) ? 'selected' : '' %>><%= person.full_name %></option>
          <% }) %>
        </select>
      </label>
    </div>
    <p style="margin-top:12px"><button class="btn btn-primary" type="submit">Update Case</button></p>
  </form>
<% } else { %>
  <p class="hint">Closed <%= exactDateTime(item.closed_at) %><% if (item.reason_code) { %> · <%= label(item.reason_code) %><% } %>.</p>
<% } %>
