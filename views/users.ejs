<header class="page-head">
  <div>
    <p class="eyebrow">Access</p>
    <h1>User Accounts</h1>
    <p class="lede">Create accounts, change roles, and disable sign-in.</p>
  </div>
  <a class="btn btn-primary" href="/users/new">New User</a>
</header>
<div class="table-wrap">
  <table class="stack-rows">
    <thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Region</th><th>Status</th><th>Set Password</th></tr></thead>
    <tbody>
      <% rows.forEach((row) => { %>
        <tr>
          <td data-label="Name"><%= row.full_name %></td>
          <td data-label="Username"><%= row.username %></td>
          <td data-label="Role"><%= roleLabel(row.role) %></td>
          <td data-label="Region"><%= row.region || 'All Regions' %></td>
          <td data-label="Status">
            <%= row.active ? 'Active' : 'Disabled' %>
            <% if (!row.has_password) { %><br><span class="hint">No password</span><% } %>
            <% if (row.locked) { %><br><span class="hint">Locked</span><% } %>
            <form method="post" action="/users/<%= row.user_id %>/unlock">
              <%- csrfField %>
              <button class="btn" type="submit">Unlock</button>
            </form>
          </td>
          <td data-label="Set Password">
            <form method="post" action="/users/<%= row.user_id %>/password" enctype="application/x-www-form-urlencoded" autocomplete="on">
              <%- csrfField %>
              <label class="field" for="username-<%= row.user_id %>">Username
                <input id="username-<%= row.user_id %>" name="username" autocomplete="username" value="<%= row.username %>" readonly>
              </label>
              <label class="field" for="new-password-<%= row.user_id %>">New password
                <input id="new-password-<%= row.user_id %>" name="new-password" type="password" autocomplete="new-password" required>
              </label>
              <label class="field" for="confirm-password-<%= row.user_id %>">Confirm password
                <input id="confirm-password-<%= row.user_id %>" name="confirm-password" type="password" autocomplete="new-password" required>
              </label>
              <button class="btn" type="submit">Set Password</button>
            </form>
            <p class="hint"><a href="/users/<%= row.user_id %>">Edit account</a></p>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
