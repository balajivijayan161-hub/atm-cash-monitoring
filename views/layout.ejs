<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ATM Cash Operations</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,640&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="shell">
    <aside class="sidebar">
      <div class="brand">
        <div class="mark" aria-hidden="true">₹</div>
        <div>
          <strong>ATM Cash Operations</strong>
          <span>Cash Operations</span>
        </div>
      </div>
      <p class="nav-label">Monitor</p>
      <nav class="nav" aria-label="Primary">
        <a class="<%= navClass('/') %>" href="/"<% if (navClass('/')) { %> aria-current="page"<% } %>>Uptime Dashboard</a>
        <a class="<%= navClass('/atms') %>" href="/atms"<% if (navClass('/atms')) { %> aria-current="page"<% } %>>ATMs</a>
        <a class="<%= navClass('/tickets') %>" href="/tickets"<% if (navClass('/tickets')) { %> aria-current="page"<% } %>>Fault Tickets</a>
        <a class="<%= navClass('/alerts') %>" href="/alerts"<% if (navClass('/alerts')) { %> aria-current="page"<% } %>>Cash Alerts</a>
        <a class="<%= navClass('/downtime') %>" href="/downtime"<% if (navClass('/downtime')) { %> aria-current="page"<% } %>>Open Downtime</a>
      </nav>
      <p class="nav-label">Cash</p>
      <nav class="nav" aria-label="Cash">
        <a class="<%= navClass('/forecast') %>" href="/forecast"<% if (navClass('/forecast')) { %> aria-current="page"<% } %>>Cash Forecast</a>
        <a class="<%= navClass('/runs') %>" href="/runs"<% if (navClass('/runs')) { %> aria-current="page"<% } %>>Replenishment Runs</a>
        <a class="<%= navClass('/reconciliations') %>" href="/reconciliations"<% if (navClass('/reconciliations')) { %> aria-current="page"<% } %>>Reconciliation</a>
        <a class="<%= navClass('/switch') %>" href="/switch"<% if (navClass('/switch')) { %> aria-current="page"<% } %>>Bank Data Import</a>
        <a class="<%= navClass('/imports') %>" href="/imports"<% if (navClass('/imports')) { %> aria-current="page"<% } %>>Import History</a>
      </nav>
      <p class="nav-label">Reports</p>
      <nav class="nav" aria-label="Reports">
        <a class="<%= navClass('/reports/downtime-atms') %>" href="/reports/downtime-atms"<% if (navClass('/reports/downtime-atms')) { %> aria-current="page"<% } %>>Downtime Above 5%</a>
        <a class="<%= navClass('/reports/van-cashouts') %>" href="/reports/van-cashouts"<% if (navClass('/reports/van-cashouts')) { %> aria-current="page"<% } %>>Van Cash-Outs</a>
        <a class="<%= navClass('/reports/withdrawal-matrix') %>" href="/reports/withdrawal-matrix"<% if (navClass('/reports/withdrawal-matrix')) { %> aria-current="page"<% } %>>Withdrawal Matrix</a>
        <a class="<%= navClass('/reports/downtime-by-location') %>" href="/reports/downtime-by-location"<% if (navClass('/reports/downtime-by-location')) { %> aria-current="page"<% } %>>Downtime by Location</a>
        <a class="<%= navClass('/operations/ej-archive') %>" href="/operations/ej-archive"<% if (navClass('/operations/ej-archive')) { %> aria-current="page"<% } %>>Electronic Journal Archive</a>
      </nav>
    </aside>
    <div class="content">
      <% if (notice) { %><p class="banner ok" role="status"><%= notice %></p><% } %>
      <% if (warning) { %><p class="banner bad" role="alert"><%= warning %></p><% } %>
      <%- pageBody %>
    </div>
  </div>
</body>
</html>
