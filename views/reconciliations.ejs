<header class="page-head">
  <div>
    <p class="eyebrow">After the count</p>
    <h1>Reconciliations</h1>
    <p class="lede">A difference other than zero raises a fault ticket through the database trigger on insert. A matched count does not.</p>
  </div>
  <a class="btn btn-primary" href="/reconciliations/new">New reconciliation</a>
</header>
<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Date</th><th>ATM</th><th class="num">Expected</th><th class="num">Counted</th><th class="num">Difference</th><th>Ticket</th></tr>
    </thead>
    <tbody>
      <% if (!rows.length) { %><tr><td colspan="6" class="empty">No reconciliations yet.</td></tr><% } %>
      <% rows.forEach((row) => { %>
        <tr>
          <td><%= prettyDate(row.recon_date) %></td>
          <td><a href="/atms/<%= row.atm_id %>"><%= row.atm_code %></a><br><span class="hint"><%= row.site_name %></span></td>
          <td class="num"><%= inr(row.expected_amount) %></td>
          <td class="num"><%= inr(row.counted_amount) %></td>
          <td class="num <%= Number(row.difference) ? 'bad-num' : '' %>"><%= inr(row.difference) %></td>
          <td>
            <% if (row.ticket_no) { %>
              <a href="/tickets"><%= row.ticket_no %></a>
              <span class="pill <%= row.ticket_status %>"><%= row.ticket_status %></span>
            <% } else { %>Matched<% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
