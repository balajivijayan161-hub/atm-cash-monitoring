# PostgreSQL connection string. Works with local Postgres, Neon, or Render Postgres.
DATABASE_URL=postgres://atm_ops:atm_ops@127.0.0.1:5432/atm_cash

# Port the web process listens on. Render sets PORT automatically.
PORT=43123

# Scheduled switch-file drop. The poller is on by default inside the web process.
# Set SWITCH_POLL_MS=0 to disable it. Render free disk is ephemeral, so a dropped
# file disappears on restart; the dashboard live feed is the durable demo source.
SWITCH_INBOUND_DIR=data/inbound
SWITCH_PROCESSED_DIR=data/processed
SWITCH_REJECTED_DIR=data/rejected
SWITCH_POLL_MS=300000

# Ingestion rules. Cash at or above this percent of capacity does not raise an alert.
CASH_ALERT_PCT=20
# Minutes an ATM must stay offline before a downtime row is opened.
OFFLINE_MINUTES=2

# Live feed. It never starts on its own, and it stops after SIMULATOR_MAX_MS.
SIMULATOR_TICK_MS=4000
SIMULATOR_MAX_MS=900000

# Sign-in. SESSION_SECRET is required in production.
# ADMIN_PASSWORD and DEMO_PASSWORD are optional. When they are set, startup gives
# those passwords to superadmin and the other sample accounts. When they are unset,
# those accounts have no password: open /setup (needs SETUP_TOKEN) for superadmin,
# then set the other passwords from User Accounts.
SESSION_SECRET=
ADMIN_PASSWORD=
DEMO_PASSWORD=
SETUP_TOKEN=
# Optional. Idle timeout and absolute session length.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
